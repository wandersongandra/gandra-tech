    "optimize:images": "node scripts/optimize-images.mjs",
    "validate:build-security": "node scripts/validate-build-security.mjs",
    "check:production": "node scripts/check-production.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.62.1",
    "satori": "0.32.0",
    "sharp": "^0.35.4",
    "typescript": "^5"
  }
