{
  "name": "gandra-tech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run generate:og && next build",
    "generate:og": "node scripts/generate-og-images.mjs",
    "start": "next start",
    "lint": "node scripts-lint.cjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "test": "node scripts-test.cjs",
